{
  "name": "Ultimate AI YouTube Shorts Automation",
  "nodes": [
    {
      "parameters": {},
      "id": "1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "2",
      "name": "Auto Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 500]
    },
    {
      "parameters": {
        "url": "https://www.reddit.com/r/shorts.json",
        "responseFormat": "json"
      },
      "id": "3",
      "name": "Get Reddit Viral",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [350, 150]
    },
    {
      "parameters": {
        "url": "https://newsapi.org/v2/top-headlines?country=us&apiKey=YOUR_NEWS_API_KEY",
        "responseFormat": "json"
      },
      "id": "4",
      "name": "Get Viral News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [350, 300]
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/youtube/v3/videos?part=snippet&chart=mostPopular&maxResults=10&regionCode=US&key=YOUR_YOUTUBE_API_KEY",
        "responseFormat": "json"
      },
      "id": "5",
      "name": "Get YouTube Trends",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [350, 450]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "content": "Analyze all trending data and create a highly viral YouTube Shorts idea. Generate:\n1. Hook\n2. 45 second script\n3. Cinematic scene instructions\n4. SEO title\n5. SEO description\n6. Trending hashtags\n7. Thumbnail text\n8. CTA"
            }
          ]
        }
      },
      "id": "6",
      "name": "AI Script Generator",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "openAiApi": {
          "id": "1",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "model": "eleven_multilingual_v2",
        "text": "={{$json[\"content\"]}}"
      },
      "id": "7",
      "name": "AI Voice Generator",
      "type": "n8n-nodes-base.elevenLabs",
      "typeVersion": 1,
      "position": [900, 150]
    },
    {
      "parameters": {
        "url": "https://api.pexels.com/videos/search?query=technology&per_page=10",
        "responseFormat": "json",
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "YOUR_PEXELS_API_KEY"
            }
          ]
        }
      },
      "id": "8",
      "name": "Get Cinematic Clips",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 350]
    },
    {
      "parameters": {
        "url": "https://api.pexels.com/videos/search?query=viral+background&per_page=5",
        "responseFormat": "json",
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "YOUR_PEXELS_API_KEY"
            }
          ]
        }
      },
      "id": "9",
      "name": "Get Extra B-Roll",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 500]
    },
    {
      "parameters": {
        "command": "ffmpeg -y -i voice.mp3 -i video1.mp4 -i video2.mp4 -filter_complex \"[1:v]scale=1080:1920[v0];[2:v]scale=1080:1920[v1];[v0][v1]concat=n=2:v=1:a=0[outv]\" -map \"[outv]\" -map 0:a -shortest output.mp4"
      },
      "id": "10",
      "name": "Create Beautiful Short",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "command": "ffmpeg -i output.mp4 -vf subtitles=subtitles.srt final_output.mp4"
      },
      "id": "11",
      "name": "Add Auto Captions",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "operation": "send",
        "fromEmail": "yourgmail@gmail.com",
        "toEmail": "paridapadmaraj124@gmail.com",
        "subject": "🔥 Viral AI YouTube Short Ready",
        "text": "Your fully edited AI-generated YouTube Shorts video is attached.\n\nIncludes:\n✅ Viral topic\n✅ AI voice\n✅ Cinematic editing\n✅ Captions\n✅ SEO title\n✅ Hashtags\n✅ Description",
        "attachments": "final_output.mp4"
      },
      "id": "12",
      "name": "Send Final Video Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1700, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "1",
          "name": "Gmail"
        }
      }
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{$json[\"title\"]}}",
        "description": "={{$json[\"description\"]}}",
        "additionalFields": {
          "privacyStatus": "public"
        }
      },
      "id": "13",
      "name": "Upload To YouTube",
      "type": "n8n-nodes-base.youtube",
      "typeVersion": 1,
      "position": [1700, 500]
    }
  ],
